          </row>
          <row>
            <cell>Dani's grumpiness</cell>
            <cell>41</cell>
            <cell>91</cell>
            <cell>63.71</cell>
            <cell>62</cell>
            <cell>10.05</cell>
            <cell>14</cell>
          </row>
          <row>
            <cell>Dani's hours slept</cell>
            <cell>4.84</cell>
            <cell>9.00</cell>
            <cell>6.97</cell>
            <cell>7.03</cell>
            <cell>1.02</cell>
            <cell>1.45</cell>
          </row>
          <row>
            <cell>Dani's son's hours slept</cell>
            <cell>3.25</cell>
            <cell>12.07</cell>
            <cell>8.05</cell>
            <cell>7.95</cell>
